# what a build writes
/build/

# The data of the game is not ours and is never committed: the player's own
# copy of id1, or any other game folder, wherever it is put. Copies kept
# side by side, as id1.librequake, are ignored as well.
id1*/
*.pak
*.PAK

.DS_Store

# trees of the same repository, for work side by side
/worktrees/

# the level a player chose to look at, on their own machine
/assets/level.txt
